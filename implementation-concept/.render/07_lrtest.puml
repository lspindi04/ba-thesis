@startuml
title DeviceIntegrationPlugin – geprüftes Ziel-Klassendiagramm für die Implementierung
left to right direction
skinparam dpi 150
skinparam linetype ortho
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 28
skinparam ranksep 38
hide circle
hide empty members

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #315A7D
  ArrowColor #315A7D
  FontColor #18344D
  BackgroundColor<<begonnen>> #E7F6EA
  BorderColor<<begonnen>> #2E7D32
  BackgroundColor<<neu>> #EAF3FB
  BorderColor<<neu>> #1976B9
  BackgroundColor<<extrahieren>> #FFF3D6
  BorderColor<<extrahieren>> #C17D00
  BackgroundColor<<wiederverwenden>> #F1F1F1
  BorderColor<<wiederverwenden>> #777777
  BackgroundColor<<anpassen>> #FDEDD7
  BorderColor<<anpassen>> #B66A12
  BackgroundColor<<out-of-scope>> #FAE8E8
  BorderColor<<out-of-scope>> #B54848
  BackgroundColor<<test>> #F4EAFB
  BorderColor<<test>> #76519A
}

legend right
  |= Farbe |= Bedeutung |
  |<#E7F6EA>| im neuen Plugin bereits als Datei angelegt |
  |<#EAF3FB>| für die Bachelorarbeit neu implementieren |
  |<#FFF3D6>| aus dem Showcase-AgentManager extrahieren und weiterentwickeln |
  |<#F1F1F1>| vorhandenen Vertrag / vorhandene Klasse wiederverwenden |
  |<#FDEDD7>| vorhandene gemeinsame Basis oder Composition Root anpassen |
  |<#FAE8E8>| bestehende Grenze; Low Priority oder Out of Scope |
  |<#F4EAFB>| automatisierter Test |
endlegend

